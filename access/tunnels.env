# DB tunnel targets — hosts and ports only, no secrets (safe to commit). Ports are the convention the memory notes use.
# The PEM key is per person and never in git: ABE_SSH_KEY=<path>, default ~/.ssh/ABE.pem. Per-person overrides go in
# tunnels.local.env (git-ignored).
BASTION_HOST=ec2-13-250-112-53.ap-southeast-1.compute.amazonaws.com   # EC2 "Bastion Host" i-04bfdfefcdfb089df, EIP 13.250.112.53
BASTION_USER=ec2-user
TUNNEL_3375=benefit-sit-instance-1.cofpzhamf3ov.ap-southeast-1.rds.amazonaws.com:3306   # Benefit SIT (Aspire) + UAT (AspireProdBackup)
TUNNEL_3382=benefit-prod-instance-1.cofpzhamf3ov.ap-southeast-1.rds.amazonaws.com:3306  # Benefit PROD — SELECT only
TUNNEL_3383=rsa-prod.cofpzhamf3ov.ap-southeast-1.rds.amazonaws.com:1433                 # RSA PROD MSSQL (BKKRsa)
